# Copy to .env and fill in. Never commit .env.

# Market, macro and trade APIs (only needed to refresh data/raw; the committed snapshots run without them)
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
USITC_DATAWEB_TOKEN=

# Satellite backends
# Microsoft Planetary Computer: no key needed for Sentinel-2 L2A (items are signed anonymously).
# Optional subscription key raises rate limits:
PC_SDK_SUBSCRIPTION_KEY=

# Earth Observation Group (Payne Institute) VIIRS Nightfire: free account required.
# The OIDC client id and secret are published in EOG's download instructions; copy them from there.
EOG_USERNAME=
EOG_PASSWORD=
EOG_CLIENT_ID=
EOG_CLIENT_SECRET=

# Google Earth Engine (Sentinel-5P L3 and AlphaEarth embeddings). Noncommercial Cloud project id:
EE_PROJECT=
